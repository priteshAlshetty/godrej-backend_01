    {
        "id": "01d2eb9f10e21ba8",
        "type": "function",
        "z": "1e2357629cb7ebce",
        "name": "function 4",
        "func": "let data = msg.payload;\n\nmsg.topic = `\nINSERT INTO electrode \n(electrode_id, IR_temp_1, IR_temp_2, IR_temp_3, \n chain_speed, zone_temp_1, zone_temp_2, humidity, electrode_type)\nVALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\nON DUPLICATE KEY UPDATE\n    IR_temp_1   = VALUES(IR_temp_1),\n    IR_temp_2   = VALUES(IR_temp_2),\n    IR_temp_3   = VALUES(IR_temp_3),\n    chain_speed = VALUES(chain_speed),\n    zone_temp_1 = VALUES(zone_temp_1),\n    zone_temp_2 = VALUES(zone_temp_2),\n    humidity    = VALUES(humidity),\n    electrode_type  = VALUES(electrode_type);\n`;\n\nmsg.payload = [\n    data.id_c,\n    data.irTemp1_c,\n    data.irTemp2_c,\n    data.irTemp3_c,\n    data.chain,\n    data.z1Temp_c,\n    data.z2Temp_c,\n    data.humidity,\n    data.type\n];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1220,
