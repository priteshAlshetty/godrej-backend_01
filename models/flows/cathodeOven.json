    {
        "id": "655a4bca402a52cc",
        "type": "function",
        "z": "1e2357629cb7ebce",
        "name": "create_json_object",
        "func": "let id_c = flow.get(\"ID_c\");\nlet irTemp1_c= flow.get(\"IR_temp1_c\");\nlet irTemp2_c = flow.get(\"IR_temp2_c\");\nlet irTemp3_c = flow.get(\"IR_temp3_c\");\nlet chain = flow.get(\"chain_spped\");\nlet z1Temp_c = flow.get(\"zone1_temp_c\");\nlet z2Temp_c = flow.get(\"zone2_temp_c\");\nlet humidity = flow.get(\"humidity\")\nlet type = \"Cathode\"\n    \nmsg.payload = { id_c, irTemp1_c, irTemp2_c, irTemp3_c, chain, z1Temp_c, z2Temp_c, humidity, type};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1010,
