    {
        "id": "46ddd1989ae69e2b",
        "type": "function",
        "z": "030d0f0a3ab1d03a",
        "name": "electrode_id",
        "func": "let id = msg.payload;\nlet time = new Date();\n\n// Format the date as DD-MM-YYYY\nlet date = time.toISOString().split('T')[0];\nlet dateFormat = date.split('-').reverse().join('-');\n\nlet electrode_id = \"AE \" + dateFormat + \" \" + id;\n\nflow.set(\"ID\", electrode_id);\n\nmsg.payload = electrode_id;\n  \nreturn msg;\n",
