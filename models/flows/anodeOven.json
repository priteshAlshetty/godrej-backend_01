    {
        "id": "6550b50c96ebda3b",
        "type": "function",
        "z": "030d0f0a3ab1d03a",
        "name": "query for electrode",
        "func": "let data = msg.payload;\n\nmsg.topic = `\nINSERT INTO electrode \n(electrode_id, IR_temp_1, IR_temp_2, chain_speed, zone_temp_1, zone_temp_2, electrode_type)\nVALUES (?, ?, ?, ?, ?, ?, ?)\nON DUPLICATE KEY UPDATE\n    IR_temp_1   = VALUES(IR_temp_1),\n    IR_temp_2   = VALUES(IR_temp_2),\n    chain_speed = VALUES(chain_speed),\n    zone_temp_1 = VALUES(zone_temp_1),\n    zone_temp_2 = VALUES(zone_temp_2),\n    electrode_type  = VALUES(electrode_type);\n`;\n\nmsg.payload = [\n    data.id,\n    data.irTemp1,\n    data.irTemp2,\n    data.chain_speed,\n    data.z1Temp,\n    data.z2Temp,\n    data.type\n];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1160,
        "y": 480,
        "wires": [
