    {
        "id": "8082669611d63078",
        "type": "function",
        "z": "030d0f0a3ab1d03a",
        "name": "joson object creator",
        "func": "\n    let irTemp1= flow.get(\"IR_temp1\");\n    let irTemp2 = flow.get(\"IR_temp2\");\n    let z1Temp = flow.get(\"zone1_temp\");\n    let z2Temp = flow.get(\"zone2_temp\");\n    let id = flow.get(\"ID\");\n    let chain_speed = flow.get(\"chain_speed\")\n    let type = \"Anode\"\n\n    msg.payload = { id, irTemp1, irTemp2, z1Temp, z2Temp, type, chain_speed};\n    \n\n    return msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 910,
        "y": 480,
