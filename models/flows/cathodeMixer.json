    {
        "id": "b1d3e54832de7991",
        "type": "function",
        "z": "37ccf0e434c9154b",
        "name": "bismuth_log",
        "func": "\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let batch_id = flow.get(\"id\");\n    let bismuth_c_val = flow.get(\"bismuth_c\");\n\n    if (!batch_id) {\n        node.warn(\"batch_id missing — not logging bismuth_c\");\n        return null;\n    }\n\n    let sql = `\nINSERT INTO batch_main (batch_id, bismuth)\nVALUES (?, ?)\nON DUPLICATE KEY UPDATE\nbismuth = VALUES(bismuth);\n`;\n\n    msg.topic = sql;\n    msg.payload = [batch_id, bismuth_c_val];\n\n    return msg;        // send to MySQL\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
