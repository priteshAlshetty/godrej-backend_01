    {
        "id": "77597515b0546341",
        "type": "function",
        "z": "37ccf0e434c9154b",
        "name": "data_log_query",
        "func": "let batch_id = flow.get(\"id\");\nlet mx_time = flow.get(\"mx_time\");\nlet paste_temp = flow.get(\"paste_temp\");\nlet max_current = flow.get(\"max_cur\");\nlet max_torque = flow.get(\"max_torque\");\nlet batch_size = flow.get(\"batch_size\");\nlet paste_mois = flow.get(\"paste_mois\");\nlet paste_den = flow.get(\"paste_den\");\nlet penetration = flow.get(\"pene\");\nlet ambient_temp = flow.get(\"ambient_temp\");\nlet humidity = flow.get(\"humidity\");   // fixed spelling\n\nlet sql = `\nINSERT INTO batch_main \n(batch_id, mixing_time, ambient_temp, Humidity, final_paste_temp, \n max_current, max_torque, batch_size, paste_moisture, paste_density, penetration)\nVALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\nON DUPLICATE KEY UPDATE\n    mixing_time      = VALUES(mixing_time),\n    ambient_temp     = VALUES(ambient_temp),\n    Humidity         = VALUES(Humidity),\n    final_paste_temp = VALUES(final_paste_temp),\n    max_current      = VALUES(max_current),\n    max_torque       = VALUES(max_torque),\n    batch_size       = VALUES(batch_size),\n    paste_moisture   = VALUES(paste_moisture),\n    paste_density    = VALUES(paste_density),\n    penetration      = VALUES(penetration);\n`;\n\nmsg.topic = sql;\nmsg.payload = [\n    batch_id,\n    mx_time,\n    ambient_temp,\n    humidity,\n    paste_temp,\n    max_current,\n    max_torque,\n    batch_size,\n    paste_mois,\n    paste_den,\n    penetration\n];\n\nconsole.log(msg.payload);\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 540,
        "wires": [
