    {
        "id": "35291bb0121b2429",
        "type": "function",
        "z": "37ccf0e434c9154b",
        "name": "start_time_log",
        "func": "\n\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let batch_id = flow.get(\"id\");\n\n    let sql = `INSERT INTO batch_main (batch_id, start_timestamp)\n        VALUES (?, NOW())\n        `;\n\n    msg.topic = sql;\n    msg.payload = [batch_id];\n\n\n    return msg;\n\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
