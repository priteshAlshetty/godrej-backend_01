    {
        "id": "7eae7a6d81c06e0c",
        "type": "function",
        "z": "0dfdf2ef92ca7e43",
        "name": "json_obj",
        "func": "\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let ele_id = flow.get(\"ID\");\n    let density = flow.get(\"density\");\n    let moisture = flow.get(\"moisture\");\n    let thickness1 = flow.get(\"thickness1\");\n\n    msg.payload = { ele_id, density, moisture, thickness1 };\n\n    return msg;\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
