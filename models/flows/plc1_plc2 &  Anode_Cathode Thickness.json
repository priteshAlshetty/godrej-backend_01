        "type": "function",
        "z": "0dfdf2ef92ca7e43",
        "name": "json_obj",
        "func": "\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let ele_id = flow.get(\"ID2\");\n    let density = flow.get(\"density2\");\n    let moisture = flow.get(\"moisture2\");\n    let thickness2 = flow.get(\"thickness2\");\n\n    msg.payload = { ele_id, density, moisture, thickness2 };\n\n    return msg;\n}\n\n// Otherwise do nothing\nreturn null;\n",
