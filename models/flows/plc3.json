    {
        "id": "df657b5ee7aa6e1e",
        "type": "function",
        "z": "a21af4801b6d03ca",
        "name": "battery_cell_mapping query",
        "func": "\n\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n\n    // Read values from flow context\n    let battery_id = flow.get(\"battery_id\");\n    let c1 = flow.get(\"cell1\");\n    let c2 = flow.get(\"cell2\");\n    let c3 = flow.get(\"cell3\");\n    let c4 = flow.get(\"cell4\");\n    let c5 = flow.get(\"cell5\");\n    let c6 = flow.get(\"cell6\");\n    let c7 = flow.get(\"cell7\");\n    let c8 = flow.get(\"cell8\");\n    let c9 = flow.get(\"cell9\");\n    let c10 = flow.get(\"cell10\");\n\n    // ---- SQL QUERY (CORRECTED) ----\n    let sql = `\n        INSERT INTO battery_cell_mapping\n        (battery_id, cell_id_1, cell_id_2, cell_id_3, cell_id_4, cell_id_5,\n        cell_id_6, cell_id_7, cell_id_8, cell_id_9, cell_id_10)\n\n        VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n\n        ON DUPLICATE KEY UPDATE\n            cell_id_1 = VALUES(cell_id_1),\n            cell_id_2 = VALUES(cell_id_2),\n            cell_id_3 = VALUES(cell_id_3),\n            cell_id_4 = VALUES(cell_id_4),\n            cell_id_5 = VALUES(cell_id_5),\n            cell_id_6 = VALUES(cell_id_6),\n            cell_id_7 = VALUES(cell_id_7),\n            cell_id_8 = VALUES(cell_id_8),\n            cell_id_9 = VALUES(cell_id_9),\n            cell_id_10 = VALUES(cell_id_10);\n        `;\n\n    // Attach to message for MySQL node\n    msg.topic = sql;\n    msg.payload = [\n        battery_id, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10\n    ];\n\n    return msg;        // send to MySQL\n\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1020,
        "y": 660,
        "wires": [
            [
                "a8af9ee0bebb97b8"
            ]
        ]
    },
    {
        "id": "b0169104d929ca28",
        "type": "function",
        "z": "a21af4801b6d03ca",
        "name": "battery_main query",
        "func": "\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let battery_id = flow.get(\"battery_id\");\n\n    let sql = `\n        INSERT IGNORE INTO battery_main \n        (battery_id, Date_Time, manufactured_timestamp)\n        VALUES (?, NOW(), NOW())\n    `;\n\n    msg.topic = sql;\n    msg.payload = [battery_id];\n\n    return msg;\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
