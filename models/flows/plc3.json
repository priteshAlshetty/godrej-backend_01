    {
        "id": "b37701bf4fa5bfe1",
        "type": "function",
        "z": "a21af4801b6d03ca",
        "name": "function 6",
        "func": "\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n    msg.topic = `\n    SELECT serial_num, roll_weight, roll_dia\n    FROM winding_plc\n    WHERE DATE(date_time) = CURDATE()\n    ORDER BY serial_num ASC\n    LIMIT 1\n`;\n    return msg;\n\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
