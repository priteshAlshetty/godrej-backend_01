    {
        "id": "3c4b1b939cb47c45",
        "type": "function",
        "z": "b574945dc286838f",
        "name": "on_event_json_data",
        "func": "// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let sr_num = flow.get(\"sr_num\");\n    let weight = flow.get(\"weight\");\n    let avg_dia = flow.get(\"roll_avg_dia\");\n\n    msg.payload = { sr_num, weight, avg_dia };\n    return msg;\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 340,
        "wires": [
