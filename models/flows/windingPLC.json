    {
        "id": "d887ed790d07df8e",
        "type": "function",
        "z": "b574945dc286838f",
        "name": "sql query",
        "func": "let data = msg.payload;\nlet sr_no = data.sr_num;\nlet weight = data.weight;\nlet avg_dia = data.avg_dia;\n\nlet sql = `INSERT INTO winding_plc (serial_num, roll_weight, roll_dia)\n    VALUES(?, ?, ?)\n`;\n\nmsg.payload = [sr_no, weight, avg_dia];\nmsg.topic = sql;\nreturn msg;",
        "outputs": 1,
