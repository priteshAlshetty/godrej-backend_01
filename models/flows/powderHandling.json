    {
        "id": "9d56f75e9de7efbf",
        "type": "function",
        "z": "a3af93f8b08b793f",
        "name": "anode_zinc_log",
        "func": "\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let batch_id = flow.get(\"anode_batch_id\");\n    let anode_zinc_val = flow.get(\"anode_zinc\");\n\n    if (!batch_id) {\n        node.warn(\"anode_batch_id is missing — zinc not logged\");\n        return null;\n    }\n\n    let sql = `\nINSERT INTO batch_main (batch_id, zinc_emd)\nVALUES (?, ?)\nON DUPLICATE KEY UPDATE\nzinc_emd = VALUES(zinc_emd);\n`;\n\n    msg.topic = sql;\n    msg.payload = [batch_id, anode_zinc_val];\n\n    return msg;        // send to MySQL\n}\n\n// Otherwise do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
