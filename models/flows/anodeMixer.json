    {
        "id": "64c399e64b5781e5",
        "type": "function",
        "z": "0496fc5a91ffeb7b",
        "name": "data_log",
        "func": "\n    let batch_id = flow.get(\"id\");\n    let mx_time = flow.get(\"mx_time\")\n    let paste_temp = flow.get(\"paste_temp\")\n    let max_current = flow.get(\"max_cur\")\n    let max_torque = flow.get(\"max_torque\")\n    let batch_size = flow.get(\"batch_size\")\n    let paste_mois = flow.get(\"paste_mois\")\n    let paste_den = flow.get(\"paste_den\")\n    let penetration = flow.get(\"pene\")\n    let ambient_temp = flow.get(\"ambient_temp\")\n    let humidity = flow.get(\"humidity\")\n    \n    let sql = `INSERT INTO batch_main \n    (batch_id, mixing_time, ambient_temp, Humidity, final_paste_temp, max_current, \n        max_torque, batch_size, paste_moisture, paste_density, penetration)\n    VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n\n    ON DUPLICATE KEY UPDATE\n            mixing_time = VALUES(mixing_time),\n            ambient_temp = VALUES(ambient_temp),\n            Humidity = VALUES(Humidity),\n            final_paste_temp = VALUES(final_paste_temp),\n            max_current = VALUES(max_current),\n            max_torque = VALUES(max_torque),\n            batch_size = VALUES(batch_size),\n            paste_moisture = VALUES(paste_moisture),\n            paste_density = VALUES(paste_density),\n            penetration = VALUES(penetration)`;\n\n    msg.topic = sql;\n    msg.payload = [batch_id, mx_time, ambient_temp, humidity, paste_temp, max_current, max_torque, \n                    batch_size, paste_mois, paste_den, penetration ];\n                    \n\n    console.log(msg.payload)\n\n    return msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 560,
        "wires": [
