        "func": "\n\n// Get previous trigger value\nlet prev = context.get(\"prev_trigger\") || 0;\nlet current = msg.payload ? 1 : 0;\n\n// Store current value for next comparison\ncontext.set(\"prev_trigger\", current);\n\n// Rising edge condition: 0 → 1\nif (prev === 0 && current === 1) {\n\n    let batch_id = flow.get(\"id\");\n    let laponite_val = flow.get(\"laponite\");\n\n    let sql = `\nINSERT INTO batch_main (batch_id, laponite)\nVALUES (?, ?)\nON DUPLICATE KEY UPDATE\nlaponite = VALUES(laponite);\n`;\n\n    msg.topic = sql;\n    msg.payload = [batch_id, laponite_val];\n\n    flow.set(\"laponite_last_state\", current);\n    return msg;        // send to MySQL\n}\n\n// Otherwise do nothing\nreturn null;\n",
